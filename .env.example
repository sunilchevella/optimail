# Copy to .env.local and fill in from your Supabase project.
# .env.local is gitignored, so these values never reach GitHub.

# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Project Settings -> API -> service_role / secret key. Server only, never in the browser.
# Used to create logins and to read/write the private attachments bucket.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Connect button -> Session pooler (port 5432), with your database password filled in.
# The app uses this; it works from Vercel. Use a password with only letters and numbers,
# or URL-encode symbols (@ is %40).
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres

# Used only by drizzle-kit for migrations. The session pooler URL works; the direct host
# (db.<ref>.supabase.co) is IPv6-only and often unreachable.
DIRECT_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres

# Vercel Cron sends this to /api/health (daily keep-alive). Any long random string.
CRON_SECRET=
